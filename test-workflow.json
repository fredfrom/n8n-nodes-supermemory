{
	"id": "supermemory-test-001",
	"name": "Supermemory Test Workflow",
	"nodes": [
		{
			"parameters": {},
			"id": "trigger-1",
			"name": "Manual Trigger",
			"type": "n8n-nodes-base.manualTrigger",
			"typeVersion": 1,
			"position": [100, 600]
		},

		{
			"parameters": {
				"resource": "memory",
				"operation": "create",
				"containerTag": "n8n-test-user",
				"content": "User prefers dark mode and metric units",
				"additionalFields": {
					"isStatic": true,
					"metadata": "{\"source\": \"onboarding\", \"category\": \"preferences\"}"
				}
			},
			"id": "mem-create",
			"name": "M1 Create Memory",
			"type": "n8n-nodes-supermemory.supermemory",
			"typeVersion": 1,
			"position": [350, 200],
			"credentials": { "supermemoryApi": { "id": "", "name": "Supermemory API" } }
		},
		{
			"parameters": {
				"resource": "memory",
				"operation": "getAll",
				"containerTags": "n8n-test-user",
				"additionalFields": { "limit": 50 }
			},
			"id": "mem-list",
			"name": "M2 List Memories",
			"type": "n8n-nodes-supermemory.supermemory",
			"typeVersion": 1,
			"position": [600, 200],
			"credentials": { "supermemoryApi": { "id": "", "name": "Supermemory API" } }
		},
		{
			"parameters": {
				"resource": "memory",
				"operation": "search",
				"query": "What does the user prefer?",
				"additionalFields": { "containerTag": "n8n-test-user", "limit": 5, "threshold": 0.3, "searchMode": "memories" }
			},
			"id": "mem-search",
			"name": "M3 Search Memories",
			"type": "n8n-nodes-supermemory.supermemory",
			"typeVersion": 1,
			"position": [850, 200],
			"credentials": { "supermemoryApi": { "id": "", "name": "Supermemory API" } }
		},
		{
			"parameters": {
				"resource": "memory",
				"operation": "update",
				"containerTag": "n8n-test-user",
				"identifyBy": "content",
				"existingContent": "User prefers dark mode and metric units",
				"newContent": "User prefers dark mode, metric units, and English language",
				"additionalFields": {}
			},
			"id": "mem-update",
			"name": "M4 Update Memory",
			"type": "n8n-nodes-supermemory.supermemory",
			"typeVersion": 1,
			"position": [1100, 200],
			"credentials": { "supermemoryApi": { "id": "", "name": "Supermemory API" } }
		},
		{
			"parameters": {
				"resource": "memory",
				"operation": "delete",
				"containerTag": "n8n-test-user",
				"identifyBy": "content",
				"content": "User prefers dark mode, metric units, and English language",
				"additionalFields": { "reason": "Test cleanup" }
			},
			"id": "mem-delete",
			"name": "M5 Delete Memory",
			"type": "n8n-nodes-supermemory.supermemory",
			"typeVersion": 1,
			"position": [1350, 200],
			"credentials": { "supermemoryApi": { "id": "", "name": "Supermemory API" } }
		},

		{
			"parameters": {
				"resource": "document",
				"operation": "add",
				"content": "Supermemory is an AI memory platform that helps applications remember user context.",
				"additionalFields": { "containerTag": "n8n-test-docs", "metadata": "{\"type\": \"test\"}" }
			},
			"id": "doc-add",
			"name": "D1 Add Document",
			"type": "n8n-nodes-supermemory.supermemory",
			"typeVersion": 1,
			"position": [350, 500],
			"credentials": { "supermemoryApi": { "id": "", "name": "Supermemory API" } }
		},
		{
			"parameters": {
				"resource": "document",
				"operation": "get",
				"documentId": "={{ $json.id }}"
			},
			"id": "doc-get",
			"name": "D2 Get Document",
			"type": "n8n-nodes-supermemory.supermemory",
			"typeVersion": 1,
			"position": [600, 500],
			"credentials": { "supermemoryApi": { "id": "", "name": "Supermemory API" } }
		},
		{
			"parameters": {
				"resource": "document",
				"operation": "update",
				"documentId": "={{ $json.id }}",
				"content": "Supermemory is an AI memory and knowledge management platform with semantic search.",
				"additionalFields": { "metadata": "{\"type\": \"test\", \"updated\": true}" }
			},
			"id": "doc-update",
			"name": "D3 Update Document",
			"type": "n8n-nodes-supermemory.supermemory",
			"typeVersion": 1,
			"position": [850, 500],
			"credentials": { "supermemoryApi": { "id": "", "name": "Supermemory API" } }
		},
		{
			"parameters": {
				"resource": "document",
				"operation": "getChunks",
				"documentId": "={{ $json.id }}"
			},
			"id": "doc-chunks",
			"name": "D4 Get Chunks",
			"type": "n8n-nodes-supermemory.supermemory",
			"typeVersion": 1,
			"position": [1100, 500],
			"credentials": { "supermemoryApi": { "id": "", "name": "Supermemory API" } }
		},
		{
			"parameters": {
				"resource": "document",
				"operation": "getAll",
				"additionalFields": { "containerTags": "n8n-test-docs", "limit": 50, "includeContent": true, "sort": "createdAt", "order": "desc" }
			},
			"id": "doc-list",
			"name": "D5 List Documents",
			"type": "n8n-nodes-supermemory.supermemory",
			"typeVersion": 1,
			"position": [1350, 500],
			"credentials": { "supermemoryApi": { "id": "", "name": "Supermemory API" } }
		},
		{
			"parameters": {
				"resource": "document",
				"operation": "getProcessing"
			},
			"id": "doc-processing",
			"name": "D6 Get Processing",
			"type": "n8n-nodes-supermemory.supermemory",
			"typeVersion": 1,
			"position": [1600, 500],
			"credentials": { "supermemoryApi": { "id": "", "name": "Supermemory API" } }
		},
		{
			"parameters": {
				"resource": "document",
				"operation": "delete",
				"documentId": "={{ $('D1 Add Document').item.json.id }}"
			},
			"id": "doc-delete",
			"name": "D7 Delete Document",
			"type": "n8n-nodes-supermemory.supermemory",
			"typeVersion": 1,
			"position": [1850, 500],
			"credentials": { "supermemoryApi": { "id": "", "name": "Supermemory API" } }
		},

		{
			"parameters": {
				"resource": "document",
				"operation": "batchAdd",
				"documents": "[\n  { \"content\": \"Batch doc 1: Machine learning is a subset of AI\", \"customId\": \"n8n-batch-1\" },\n  { \"content\": \"Batch doc 2: Deep learning uses neural networks\", \"customId\": \"n8n-batch-2\" },\n  { \"content\": \"Batch doc 3: NLP processes human language\", \"customId\": \"n8n-batch-3\" }\n]",
				"additionalFields": { "containerTag": "n8n-test-batch", "metadata": "{\"batch\": true}" }
			},
			"id": "doc-batch",
			"name": "B1 Batch Add Docs",
			"type": "n8n-nodes-supermemory.supermemory",
			"typeVersion": 1,
			"position": [350, 800],
			"credentials": { "supermemoryApi": { "id": "", "name": "Supermemory API" } }
		},
		{
			"parameters": {
				"resource": "document",
				"operation": "bulkDelete",
				"documentIds": "n8n-batch-1,n8n-batch-2,n8n-batch-3"
			},
			"id": "doc-bulk-delete",
			"name": "B2 Bulk Delete Docs",
			"type": "n8n-nodes-supermemory.supermemory",
			"typeVersion": 1,
			"position": [600, 800],
			"credentials": { "supermemoryApi": { "id": "", "name": "Supermemory API" } }
		},

		{
			"parameters": {
				"resource": "search",
				"operation": "searchDocuments",
				"query": "AI memory platform",
				"additionalFields": { "limit": 10, "includeSummary": true }
			},
			"id": "search-docs",
			"name": "S1 Search Documents",
			"type": "n8n-nodes-supermemory.supermemory",
			"typeVersion": 1,
			"position": [350, 1100],
			"credentials": { "supermemoryApi": { "id": "", "name": "Supermemory API" } }
		},
		{
			"parameters": {
				"resource": "search",
				"operation": "searchMemories",
				"query": "user preferences",
				"additionalFields": { "containerTag": "n8n-test-user", "limit": 10, "threshold": 0.3, "searchMode": "memories" }
			},
			"id": "search-mems",
			"name": "S2 Search Memories v4",
			"type": "n8n-nodes-supermemory.supermemory",
			"typeVersion": 1,
			"position": [600, 1100],
			"credentials": { "supermemoryApi": { "id": "", "name": "Supermemory API" } }
		},

		{
			"parameters": {
				"resource": "container",
				"operation": "updateSettings",
				"containerTag": "n8n-test-docs",
				"entityContext": "Test documents from n8n Supermemory integration."
			},
			"id": "ctr-update",
			"name": "C1 Update Container",
			"type": "n8n-nodes-supermemory.supermemory",
			"typeVersion": 1,
			"position": [350, 1400],
			"credentials": { "supermemoryApi": { "id": "", "name": "Supermemory API" } }
		},
		{
			"parameters": {
				"resource": "container",
				"operation": "getSettings",
				"containerTag": "n8n-test-docs"
			},
			"id": "ctr-get",
			"name": "C2 Get Container",
			"type": "n8n-nodes-supermemory.supermemory",
			"typeVersion": 1,
			"position": [600, 1400],
			"credentials": { "supermemoryApi": { "id": "", "name": "Supermemory API" } }
		},
